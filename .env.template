USER_AGENT="Mozilla/5.0 (Macintosh; Intel Mac OS X 10_11_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/47.0.2526.106 Safari/537.36"
START_DATE=2010-05-02
# SQLite file holding crawled movies and Trakt tokens.
# The Docker image sets this to /data/movies.db; leave it as below for local runs.
DB_NAME=movies.db
DOUBAN_BASE_URL=https://movie.douban.com
DOUBAN_USERNAME=
# Trakt app (https://app.trakt.tv/settings/apps/api). Only the client id is
# needed: authorization uses the device code flow, no client secret.
TRAKT_CLIENT_ID=
# Optional. Only set it if your Trakt app has a redirect URI configured;
# the token refresh request must send the same value.
#TRAKT_REDIRECT_URI=
# Daemon mode only (npm run daemon / Docker). Each run waits
# SYNC_INTERVAL_HOURS plus a random 0..SYNC_JITTER_HOURS before the next one,
# so runs never hit Douban on a fixed schedule. The Trakt token is checked
# daily regardless of the interval.
SYNC_INTERVAL_HOURS=168
SYNC_JITTER_HOURS=24
