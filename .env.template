USER_AGENT="Mozilla/5.0 (Macintosh; Intel Mac OS X 10_11_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/47.0.2526.106 Safari/537.36"
START_DATE=2010-05-02
# SQLite file holding crawled movies and Trakt tokens.
# The Docker image sets this to /data/movies.db; leave it as below for local runs.
DB_NAME=movies.db
DOUBAN_BASE_URL=https://movie.douban.com
DOUBAN_USERNAME=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:3000/auth/trakt/callback
# Daemon mode only (npm run daemon / Docker): hours between sync runs.
SYNC_INTERVAL_HOURS=24
